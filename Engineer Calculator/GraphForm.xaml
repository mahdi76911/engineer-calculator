<Window x:Name="GraphWin" x:Class="Engineer_Calculator.GraphForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Engineer_Calculator"
        mc:Ignorable="d"
        Title="GraphForm" Height="500" Width="600" Closed="GraphWin_Closed">
    <Grid x:Name="FormGrid" Margin="0,10,3.6,-2.6" RenderTransformOrigin="0.494,0.642" Width="590" Height="450">
        <Button x:Name="btn1" Content="drow" HorizontalAlignment="Left" Margin="498,387,0,0" VerticalAlignment="Top" Width="75" Click="button_Click" Height="23"/>
        <TextBox x:Name="textBox" HorizontalAlignment="Left" Height="30" Margin="47,406,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182" FontSize="18.667"/>
        <Label x:Name="label" Content="y=" HorizontalAlignment="Left" Height="60" Margin="10,403,0,-13" VerticalAlignment="Top" FontSize="18.667" Width="32"/>
        <Label x:Name="label_Copy" Content="From x =" HorizontalAlignment="Left" Height="60" Margin="234,403,0,-13" VerticalAlignment="Top" FontSize="18.667" Width="85"/>
        <TextBox x:Name="textBox_Copy" HorizontalAlignment="Left" Height="30" Margin="316,406,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="47" FontSize="18.667"/>
        <Label x:Name="label_Copy1" Content="To x =" Height="60" Margin="363,403,116,-13" VerticalAlignment="Top" FontSize="18.667"/>
        <TextBox x:Name="textBox_Copy1" HorizontalAlignment="Left" Height="30" Margin="421,406,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="47" FontSize="18.667"/>
        <Button x:Name="btn2" Content="clear" HorizontalAlignment="Left" Margin="498,421,0,0" VerticalAlignment="Top" Width="75" Click="btn2_Click" Height="19"/>
        <Grid x:Name="MyGrid" HorizontalAlignment="Left" Height="372" Margin="10,0,0,63" VerticalAlignment="Bottom" Width="570"/>

    </Grid>
</Window>
